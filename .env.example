# ---------------------------------------------------------------------------
# ADA Internship & Project Work Portal - local development environment
# Copy to .env (never commit .env).
# ---------------------------------------------------------------------------

PORTAL_ENV=development
LOG_LEVEL=info

# Postgres 16 (docker-compose service: db)
POSTGRES_DB=ada_portal
POSTGRES_USER=portal_owner
POSTGRES_PASSWORD=portal_owner_dev_pw

# Two privilege levels, one database (see db/grants.sql).
# portal_owner owns the schema and runs migrations; the two runtimes never use it.
MIGRATION_DATABASE_URL=postgresql://portal_owner:portal_owner_dev_pw@localhost:5433/ada_portal?schema=public
DATABASE_URL_PUBLIC=postgresql://portal_public:portal_public_dev_pw@localhost:5433/ada_portal?schema=public
DATABASE_URL_INTERNAL=postgresql://portal_internal:portal_internal_dev_pw@localhost:5433/ada_portal?schema=public

# Passwords for the two runtime roles (used by docker-compose when it builds the
# in-container DATABASE_URLs; must match db/grants.sql)
PORTAL_PUBLIC_DB_PASSWORD=portal_public_dev_pw
PORTAL_INTERNAL_DB_PASSWORD=portal_internal_dev_pw

# Secrets - rotate and inject from the deployment secret store in any real zone.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789
REFERRAL_HMAC_PEPPER=dev-only-referral-pepper-change-me-0123456789
TOTP_PEPPER=dev-only-totp-pepper-change-me-0123456789

# Development convenience only: return the freshly minted OTP and the current
# TOTP code in the API response so the login screens are demonstrable without
# a mail server or an authenticator app. Refused when PORTAL_ENV=production.
ALLOW_DEV_OTP=true

# Zone hosts/origins. A cookie is scoped per zone (name + zone claim).
PUBLIC_APP_ORIGIN=http://localhost:5173
INTERNAL_APP_ORIGIN=http://localhost:5174
PUBLIC_API_PORT=4000
INTERNAL_API_PORT=4001

# Cookies are Secure automatically when PORTAL_ENV=production. An intranet install
# served over plain HTTP must set this to false, or sign-in cannot set a session.
# COOKIE_SECURE=false

# Uploaded documents (college letters, IDs). A mounted volume in the containers.
# FILE_STORAGE_DIR=./data/files

# Built SPA folder served by the API process itself (one origin per zone).
# Leave unset to use apps/web-public/dist and apps/web-internal/dist.
# WEB_DIST=/app/apps/web-public/dist

# SMTP relay for OTP and notification email. Without it, set ALLOW_DEV_OTP=true.
# SMTP_HOST=mail.ada.internal
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ADA Internship Portal <no-reply@ada.gov.in>
