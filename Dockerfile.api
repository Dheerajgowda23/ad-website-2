# One image, two zones. ZONE decides which routers are mounted at boot.
FROM node:22-slim

ENV NODE_ENV=development
WORKDIR /app

# Prisma needs OpenSSL to pick the right query engine; slim images ship without it.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Workspace manifests first, so a source edit does not invalidate the install.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web-public/package.json apps/web-public/
COPY apps/web-internal/package.json apps/web-internal/
RUN npm ci --include=dev --no-audit --no-fund

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
COPY db db

# Prisma Client is generated against the copied schema; the engines it needs are
# downloaded during npm ci above.
RUN npm run db:generate -w @ada/api

EXPOSE 4000 4001
CMD ["node", "--import", "tsx", "apps/api/src/index.ts"]
