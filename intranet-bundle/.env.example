# ADA Internship Portal - intranet configuration
#
# install.sh / Install.ps1 writes this file for you with random secrets.
# Edit it only to change hosts, add an SMTP relay, or harden for production.

# --- runtime mode -----------------------------------------------------------
# Pilot/demo mode: PORTAL_ENV=development + ALLOW_DEV_OTP=true shows the OTP and
# TOTP code on the login screen, so no mail server is needed.
# Production: PORTAL_ENV=production + ALLOW_DEV_OTP=false + a working SMTP_HOST.
PORTAL_ENV=development
ALLOW_DEV_OTP=true
LOG_LEVEL=info

# Cookies: leave false while the portal is served over http:// on the intranet.
# Set true only when it is behind HTTPS (reverse proxy with a TLS certificate).
COOKIE_SECURE=false

# --- addresses --------------------------------------------------------------
# Use the intranet host name or IP staff will type in the browser.
PUBLIC_APP_ORIGIN=http://localhost:4000
INTERNAL_APP_ORIGIN=http://localhost:4001
PUBLIC_HOST_PORT=4000
INTERNAL_HOST_PORT=4001
POSTGRES_HOST_PORT=5433

# --- database ---------------------------------------------------------------
POSTGRES_DB=ada_portal
POSTGRES_USER=portal_owner
POSTGRES_PASSWORD=change-me-owner
PORTAL_PUBLIC_DB_PASSWORD=change-me-public
PORTAL_INTERNAL_DB_PASSWORD=change-me-internal

# --- secrets (installer generates random values) ----------------------------
SESSION_SECRET=change-me-32-chars-minimum-000000
OTP_PEPPER=change-me-16-chars-minimum-000000
REFERRAL_HMAC_PEPPER=change-me-16-chars-minimum-000000
TOTP_PEPPER=change-me-16-chars-minimum-000000

# --- email ------------------------------------------------------------------
# Internal SMTP relay. Required for real OTP delivery in production mode.
# SMTP_HOST=mail.ada.internal
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM="ADA Internship Portal <no-reply@ada.gov.in>"
